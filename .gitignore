# Publish source and documentation only. Local study inputs and outputs stay here.
*
!/.gitignore
!/README.md
!/LICENSE
!/CONTRIBUTING.md
!/SECURITY.md
!/CHANGELOG.md
!/llms.txt
!/llms-full.txt
!/requirements.txt
!/pytest.ini
!/app.py
!/config/
config/*
!config/mapping.example.json
!/src/
src/*
!src/*.py
!/tests/
tests/*
!tests/test_*.py
!/frontend/
frontend/*
!frontend/index.html
!frontend/package.json
!frontend/package-lock.json
!frontend/src/
frontend/src/*
!frontend/src/*.jsx
!frontend/src/*.mjs
!frontend/src/*.css
!frontend/tests/
frontend/tests/*
!frontend/tests/*.mjs
!frontend/tests/*.jsx
!frontend/scripts/
frontend/scripts/*
!frontend/scripts/build.py
!frontend/scripts/check-render.py
!frontend/scripts/browser-smoke.mjs
!/notebooks/
notebooks/*
!notebooks/AMR_Sentinel_Public.ipynb
!notebooks/README.md
!/docs/
docs/*
!docs/SOURCE_VERIFICATION.md
!docs/VERIFICATION.md
!/reports/
reports/*
!reports/MINI_PROJECT_REPORT.md
!/.github/
.github/*
!.github/workflows/
.github/workflows/*
!.github/workflows/ci.yml

# Extra defense if the allowlist changes later.
.env
.env.*
*.pem
*.key
**/node_modules/
**/dist/
**/data/raw/
**/results/
OneDrive_*/
